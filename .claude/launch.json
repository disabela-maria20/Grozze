{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "grozze-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "grozze-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "out", "-l", "4173"],
      "port": 4173
    },
    {
      "name": "grozze-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../node-grozze-auth-api", "run", "dev"],
      "port": 3001
    }
  ]
}
