---
import "../styles/global.css";
import { Header } from "../components/react/Header";
import { Footer } from "../components/react/Footer";
import { BottomNav } from "../components/react/BottomNav";
import { CookieBanner } from "../components/react/CookieBanner";
import { DialogRoot } from "../components/react/DialogRoot";
import { Toast } from "../components/react/Toast";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = "Filmes, cinemas e sessões para decidir mais rápido." } = Astro.props;
const fullTitle = title ? `${title} · Grozze` : "Grozze | V1 RC2";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#050807" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
  </head>
  <body class="bg-bg text-app-text">
    <Header client:only="react" />
    <main id="app">
      <slot />
    </main>
    <Footer client:only="react" />
    <BottomNav client:only="react" />
    <div id="movie-sticky"></div>
    <CookieBanner client:only="react" />
    <DialogRoot client:only="react" />
    <Toast client:only="react" />
  </body>
</html>
