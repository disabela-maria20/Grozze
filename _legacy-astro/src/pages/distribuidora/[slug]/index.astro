---
import Layout from "../../../layouts/Layout.astro";
import { DistributorPage } from "../../../components/react/DistributorPage";
import { DISTRIBUTORS } from "../../../lib/catalog";

export function getStaticPaths() {
  return DISTRIBUTORS.filter((d) => d.status === "active" && d.public).map((d) => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params;
const d = DISTRIBUTORS.find((x) => x.slug === slug);
---

<Layout title={d?.name}>
  <DistributorPage slug={slug!} client:only="react" />
</Layout>
