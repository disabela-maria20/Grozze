---
import Layout from "../../layouts/Layout.astro";
import { AccountApp } from "../../components/react/AccountApp";

export function getStaticPaths() {
  return ["salvos", "cinemas", "preferencias", "conta", "alertas"].map((part) => ({ params: { part } }));
}

const { part } = Astro.params;
const normalized = part === "alertas" ? "preferencias" : part;
---

<Layout title="Minha Grozze">
  <AccountApp part={normalized} client:only="react" />
</Layout>
