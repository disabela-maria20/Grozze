---
import Layout from "../../layouts/Layout.astro";
import { ArticleApp } from "../../components/react/ArticleApp";
import { NEWS } from "../../lib/catalog";

export function getStaticPaths() {
  return NEWS.map((n) => ({ params: { id: n.id } }));
}

const { id } = Astro.params;
const n = NEWS.find((x) => x.id === id);
---

<Layout title={n?.t} description={n?.p}>
  <ArticleApp id={id!} client:only="react" />
</Layout>
