# Grozze API. Sem NEXT_PUBLIC_GROZZE_API_URL, o front usa:
#   npm run dev   → http://localhost:3001/api
#   npm run build → https://grozze-auth.vibezz.com/api
# Defina só para apontar para outra API (ex.: homologação).
# NEXT_PUBLIC_GROZZE_API_URL=

# Chave enviada no header x-api-key; igual ao API_KEY do backend.
# Vai no JavaScript do site (visível no DevTools): não é segredo de usuário,
# mas nunca commite a chave real.
NEXT_PUBLIC_GROZZE_API_KEY=
